{
  "name": "b-sync",
  "version": "1.1.4",
  "description": "Bodhi Sync Browser",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "publish": "electron-builder --publish always",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "compression": "maximum",
    "appId": "com.priyanshu.bsync",
    "productName": "Bodhi Sync Browser",
    "icon": "icon.png",
    "files": [
      "**/*",
      "!backend",
      "!electron.zip",
      "!**/*.log",
      "!package-lock.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Priyanshu459",
        "repo": "B-sync-Bodhi-Sync-"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "**/node_modules/adblock-rs/**/*",
      "**/*.node"
    ]
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.0",
    "adblock-rs": "^0.12.5",
    "cross-fetch": "^4.0.0",
    "electron-updater": "^6.1.8"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^24.13.3"
  }
}